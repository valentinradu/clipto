[Unit]
Description=clipto bridge for a phone
# The bridge talks to clipd over its socket, so clipd must run. It survives a
# clipd restart on its own: it opens a new connection for each request.
After=clipd.service
Wants=clipd.service

[Service]
ExecStart=%h/.local/bin/clipw
Restart=on-failure
RestartSec=2

# A core dump would write the clipboard plaintext to the disk. The bridge holds
# no key, but it does hold a payload for the length of one request.
LimitCORE=0

# The bridge loads no credential. Its gate is the node identity, which
# tailscaled proves from the WireGuard session, so there is no secret here to
# seal, to carry to the phone, or to rotate.

# It reaches two Unix sockets and the tailnet, and it needs nothing else.
PrivateDevices=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
